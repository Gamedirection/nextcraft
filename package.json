{
  "name": "nextcraft",
  "version": "0.1.0",
  "private": true,
  "description": "Open and edit files in the Craft apps inside Nextcloud",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "rm -rf js && for e in files editor admin personal; do NC_ENTRY=$e vite build --mode production || exit 1; done && vite build --config vite.shim.config.js",
    "dev": "NC_ENTRY=${NC_ENTRY:-editor} vite build --mode development --watch",
    "test": "vitest run"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/capabilities": "^1.2.1",
    "@nextcloud/dialogs": "^7.6.0",
    "@nextcloud/files": "^4.1.1",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.2.0"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/vite-config": "^2.5.4",
    "jsdom": "^29.1.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
